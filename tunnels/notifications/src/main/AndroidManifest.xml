<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declare only what permissions.allow lists. This module needs no uses-permission: notification
         access is special access the user grants from Settings, and the system binds the service below. -->

    <application>
        <!-- Counts notifications. Stores one line of flags per post (importance, lock-screen visibility,
             category, ongoing, silent, hour), never the title, text or any extra. -->
        <service
            android:name=".NotifListenerService"
            android:exported="true"
            android:label="Tunnels notification counter"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
