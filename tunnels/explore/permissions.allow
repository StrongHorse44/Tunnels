# Permissions the explore module may declare, one per line. CI fails on anything else.
# Sensors and cameras need none: SensorManager.getSensorList and CameraCharacteristics are permission-free.
# Satellites: GnssStatus is a location API. No position is stored.
android.permission.ACCESS_FINE_LOCATION
# Android 12+ requires coarse next to fine in the same request, or the request is auto-denied.
android.permission.ACCESS_COARSE_LOCATION
# Radio: only for TelephonyManager.getDataNetworkType; a normal permission, so no prompt.
android.permission.READ_BASIC_PHONE_STATE
