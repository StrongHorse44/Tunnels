<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declare only what permissions.allow lists. -->
    <!-- Satellites: GnssStatus callbacks are a location API. Positions are received and dropped; only
         satellite counts and signal strengths per constellation are kept. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Radio: TelephonyManager.getDataNetworkType only. Requested when the radio tunnel opens. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
</manifest>
