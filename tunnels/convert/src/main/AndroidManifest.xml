<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Convert tunnel. No permissions: files arrive by intent grant or the file picker, output goes where you pick. -->
    <application>
        <activity
            android:name=".ConvertActivity"
            android:exported="true"
            android:label="Tunnels Convert"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Tunnels">
            <!-- Open with: documents only, so photos and PDFs keep opening in their usual viewers. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
            </intent-filter>
            <!-- Share to: everything the converter reads. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
            </intent-filter>
        </activity>
    </application>
</manifest>
