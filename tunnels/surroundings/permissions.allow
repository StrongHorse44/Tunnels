# Permissions the surroundings module may declare, one per line. CI fails on anything else.
# BLE scan window for trackers (neverForLocation: no beacon positioning).
android.permission.BLUETOOTH_SCAN
# GATT connection to one tracker the user picked in find-it mode, for the DULT non-owner service
# (read maker/model/battery, make it ring). Requested only when the user taps a DULT action; never
# used to pair or to talk to anything but the selected tag.
android.permission.BLUETOOTH_CONNECT
# Find-it mode's haptic pulses (normal permission, no prompt). View haptics honour the system
# touch-feedback switch, which many people turn off; the Vibrator does not.
android.permission.VIBRATE
# Nearby Wi-Fi scan results (neverForLocation).
android.permission.NEARBY_WIFI_DEVICES
# Android ties cell identity (TelephonyManager.allCellInfo) to location; fine must come with coarse.
android.permission.ACCESS_FINE_LOCATION
android.permission.ACCESS_COARSE_LOCATION
# Background monitor only, separate opt-in inside the tunnel.
android.permission.ACCESS_BACKGROUND_LOCATION
android.permission.FOREGROUND_SERVICE
android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE
android.permission.FOREGROUND_SERVICE_LOCATION
android.permission.POST_NOTIFICATIONS
# Wi-Fi adapter state and the connected network.
android.permission.ACCESS_WIFI_STATE
android.permission.ACCESS_NETWORK_STATE
