<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declare only what permissions.allow lists. -->
    <!-- One BLE scan window per scan, to spot trackers. Never used for positioning. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- GATT connection to the one tag the user selected in find-it mode (DULT non-owner service:
         maker, model, battery, ring). Requested only when the user taps a DULT action. The
         neverForLocation flag applies to BLUETOOTH_SCAN only; CONNECT has no location component. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Find-it mode's haptic pulses that speed up as the signal rises. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Wi-Fi scan results: security, bands, evil-twin check. Never used for positioning. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Android ties cell-tower identity to location. A cell check keeps only the technology
         (NR/LTE/UMTS/GSM) and the operator code. Each registered cell's identity (area, cell id, PCI,
         channel) is read into memory only and leaves as keyed hashes for the cell logbook (CLAUDE.md
         rule 3, hashed-set exception, off until the user starts it): no raw cell id is stored or
         logged, and no position. One position fix per scan tells whether the phone moved since the last
         scan and which place it is: a move counter and keystore-keyed hashes of ~250 m grid cells are
         kept, never coordinates. Android requires coarse next to fine. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The background monitor is a separate opt-in switch inside the tunnel. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wi-Fi adapter state and the connected network. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Background monitor: scans BLE every 2 minutes and Wi-Fi/cell every 10 while the user
             keeps it on. Started and stopped by the user only (switch or notification), never at
             boot, stops itself after 24 hours. Writes summaries to the events table only. -->
        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- Find-it mode: a continuous foreground-only BLE scan for one tracker family with a proximity
             meter, stopped when the screen is left or after 10 minutes. Keeps addresses in memory for
             the session only and writes one summary row. Reached from the tracker detail; not exported. -->
        <activity
            android:name=".FindItActivity"
            android:exported="false"
            android:label="Find it"
            android:theme="@style/Theme.Tunnels" />
    </application>
</manifest>
