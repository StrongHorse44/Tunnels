<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declare only what permissions.allow lists. Pairing reads QR codes with the camera; it never uses the network. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application>
        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:label="Second phone"
            android:theme="@style/Theme.Tunnels">
            <intent-filter>
                <action android:name="io.github.stronghorse44.tunnels.action.PAIRING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
